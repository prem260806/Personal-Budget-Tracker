PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/budget_tracker
JWT_SECRET=your_jwt_secret_key_here

# Optional: Real Email SMTP settings (Nodemailer)
# If left blank, OTPs will print directly to the server terminal & API preview
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Personal Budget Tracker" <no-reply@budgettracker.local>
